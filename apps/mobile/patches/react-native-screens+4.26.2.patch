+- (NSArray<UIViewController *> *)rnsCurrentViewControllers
+{
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 270000 && !TARGET_OS_TV && !TARGET_OS_VISION
+  if (@available(iOS 27.0, *)) {
+    // UIKit stops populating the legacy viewControllers array once tabs is set.
+    NSMutableArray<UIViewController *> *controllers = [NSMutableArray new];
+    for (UITab *tab in self.tabs) {
+      if (tab.viewController != nil) [controllers addObject:tab.viewController];
+    }
+    return controllers;
+  }
+#endif
+  return self.viewControllers;
+}
